<header class="topbar bg-white border-bottom px-4 py-2 d-flex justify-content-between align-items-center">
    <h5 class="mb-0">@ViewData["Title"]</h5>

    <div class="d-flex align-items-center gap-3">
        <span class="text-muted small"><i class="bi bi-person-circle me-1"></i>@User.Identity?.Name</span>

        @* Logout لازم POST + AntiForgery (الـ form tag helper بيضيف التوكن لوحده) *@
        <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-sm btn-outline-danger">
                <i class="bi bi-box-arrow-right me-1"></i>Logout
            </button>
        </form>
    </div>
</header>