@model TrainerViewModel

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="FullName" class="form-label">Full name</label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" maxlength="11" placeholder="01XXXXXXXXX" />
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Specialty" class="form-label"></label>
        <input asp-for="Specialty" class="form-control" placeholder="Yoga, Cardio, Bodybuilding..." />
        <span asp-validation-for="Specialty" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Bio" class="form-label"></label>
        <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Bio" class="text-danger small"></span>
    </div>
</div>