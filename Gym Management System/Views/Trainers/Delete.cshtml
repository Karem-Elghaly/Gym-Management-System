@model TrainerViewModel
@{
    ViewData["Title"] = "Delete Trainer";
}

<div class="card border-danger">
    <div class="card-body">
        <h5 class="text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete this trainer?</h5>
        <p class="mb-1"><strong>@Model.FullName</strong> - @Model.Specialty</p>
        <p class="text-muted small">Trainers with upcoming classes can't be deleted.</p>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>