@model PagedResult<MemberListItemViewModel>
@{
    ViewData["Title"] = "Members";
    var search = ViewData["Search"] as string;

    // بيانات الـ _Pagination: اسم الـ Action وباراميترات البحث اللي لازم تتحافظ في روابط الصفحات
    ViewData["Action"] = "Index";
    ViewData["Query"] = new Dictionary<string, string?> { ["search"] = search };
}

<div class="card">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
            @* GET عشان البحث يظهر في الرابط وينفع يتشير *@
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input name="search" value="@search" class="form-control" placeholder="Search by name or phone" />
                <button class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </form>

            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Member</a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>Member</th><th>Phone</th><th>Plan</th><th>Status</th><th>Joined</th><th></th></tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No members found.</td></tr>
                    }
                    @foreach (var m in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(m.ImageName))
                                    {
                                        <img src="~/uploads/members/@m.ImageName" class="member-avatar me-2" alt="" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle fs-3 text-secondary me-2"></i>
                                    }
                                    <div>
                                        <div class="fw-semibold">@m.FullName</div>
                                        <div class="text-muted small">@m.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td>@m.Phone</td>
                            <td>@(m.CurrentPlanName ?? "-")</td>
                            <td>
                                <span class="badge @(m.HasActiveSubscription ? "bg-success" : "bg-secondary")">
                                    @(m.HasActiveSubscription ? "Active" : "No subscription")
                                </span>
                            </td>
                            <td>@m.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary" title="Details"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                @* زرار الحذف للأدمن بس (الحماية الفعلية على الـ Action) *@
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted small">Total: @Model.TotalCount</span>
            @* الـ Partial بتاخد ViewData (Action و Query) تلقائي من الصفحة دي *@
            <partial name="_Pagination" model="Model.Info" />
        </div>
    </div>
</div>