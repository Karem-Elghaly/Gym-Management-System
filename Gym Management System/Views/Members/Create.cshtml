@model MemberViewModel
@{
    ViewData["Title"] = "Add Member";
}

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        @* enctype=multipart/form-data إجباري لرفع الملفات، من غيره ImageFile هتوصل null *@
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <partial name="_MemberForm" model="Model" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>