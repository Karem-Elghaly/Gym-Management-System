@model MemberViewModel
@{
    ViewData["Title"] = "Delete Member";
}

<div class="card border-danger">
    <div class="card-body">
        <h5 class="text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Are you sure you want to delete this member?</h5>
        <p class="mb-1"><strong>@Model.FullName</strong> - @Model.Phone</p>
        <p class="text-muted small">The member will be hidden from the system but their history (subscriptions and payments) is kept.</p>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>