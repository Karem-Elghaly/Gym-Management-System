@model ClassDetailsViewModel
@{
    ViewData["Title"] = "Class Details";
    var canManage = User.IsInRole("Admin") || User.IsInRole("Receptionist");
    var started = Model.StartTime <= DateTime.Now;

    string Badge(BookingStatus s) => s switch
    {
        BookingStatus.Booked => "bg-primary",
        BookingStatus.Attended => "bg-success",
        _ => "bg-secondary"
    };
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h5 class="fw-bold">@Model.Name</h5>
                <p class="text-muted">@Model.Description</p>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item"><i class="bi bi-person-badge me-2"></i>@Model.TrainerName</li>
                    <li class="list-group-item"><i class="bi bi-clock me-2"></i>@Model.StartTime.ToString("yyyy-MM-dd HH:mm") - @Model.EndTime.ToString("HH:mm")</li>
                    <li class="list-group-item"><i class="bi bi-people me-2"></i>Capacity: @Model.MaxCapacity</li>
                    <li class="list-group-item"><i class="bi bi-door-open me-2"></i>Available seats: <strong>@Model.AvailableSeats</strong></li>
                </ul>

                <div class="mt-3 d-flex gap-2">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Delete this class?');">
                            <button class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        @if (canManage && !started && Model.AvailableSeats > 0)
        {
            <div class="card mt-3">
                <div class="card-header bg-white fw-bold">Book a member</div>
                <div class="card-body">
                    <form asp-action="Book" method="post">
                        <input type="hidden" name="GymClassId" value="@Model.Id" />
                        <select name="MemberId" asp-items="(SelectList)ViewBag.Members" class="form-select mb-3">
                            <option value="">-- Select member --</option>
                        </select>
                        <button class="btn btn-primary w-100">Book</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white fw-bold">Bookings</div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light"><tr><th>Member</th><th>Booked at</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @if (!Model.Bookings.Any())
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">No bookings yet.</td></tr>
                        }
                        @foreach (var b in Model.Bookings)
                        {
                            <tr>
                                <td>@b.MemberName</td>
                                <td>@b.BookedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge @Badge(b.Status)">@b.Status</span></td>
                                <td class="text-end">
                                    @if (canManage && b.Status == BookingStatus.Booked && !started)
                                    {
                                        <form asp-action="CancelBooking" method="post" class="d-inline">
                                            <input type="hidden" name="bookingId" value="@b.BookingId" />
                                            <input type="hidden" name="classId" value="@Model.Id" />
                                            <button class="btn btn-sm btn-outline-danger">Cancel</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>