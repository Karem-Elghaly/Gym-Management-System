@model IReadOnlyList<ClassListItemViewModel>
@{
    ViewData["Title"] = "Classes";
    var canManage = User.IsInRole("Admin") || User.IsInRole("Receptionist");
}

<div class="card">
    <div class="card-body">
        @if (canManage)
        {
            <div class="d-flex justify-content-end mb-3">
                <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Class</a>
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>Class</th><th>Trainer</th><th>Starts</th><th>Ends</th><th>Seats</th><th></th></tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No classes yet.</td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@c.Name</td>
                            <td>@c.TrainerName</td>
                            <td>@c.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@c.EndTime.ToString("HH:mm")</td>
                            <td>
                                <span class="badge @(c.IsFull ? "bg-danger" : "bg-success")">
                                    @c.BookedCount / @c.MaxCapacity
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary" title="Details"><i class="bi bi-eye"></i></a>
                                @if (canManage)
                                {
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>