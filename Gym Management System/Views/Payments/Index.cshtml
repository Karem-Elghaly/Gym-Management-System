@model PagedResult<PaymentListItemViewModel>
@{
    ViewData["Title"] = "Payments";
    ViewData["Action"] = "Index";
    ViewData["Query"] = new Dictionary<string, string?>();
}

<div class="card">
    <div class="card-body">
        <div class="d-flex justify-content-end mb-3">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Payment</a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>Date</th><th>Member</th><th>Plan</th><th>Amount</th><th>Method</th><th>Notes</th><th></th></tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No payments yet.</td></tr>
                    }
                    @foreach (var p in Model.Items)
                    {
                        <tr>
                            @* التواريخ متخزنة UTC فبنحولها للتوقيت المحلي للعرض *@
                            <td>@p.PaidAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="fw-semibold">@p.MemberName</td>
                            <td>@p.PlanName</td>
                            <td class="text-success fw-semibold">@p.Amount.ToString("N0") EGP</td>
                            <td><span class="badge bg-light text-dark border">@p.Method</span></td>
                            <td class="text-muted small">@p.Notes</td>
                            <td class="text-end">
                                <a asp-controller="Subscriptions" asp-action="Details" asp-route-id="@p.SubscriptionId" class="btn btn-sm btn-outline-secondary" title="Subscription"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center">
            <span class="text-muted small">Total: @Model.TotalCount</span>
            <partial name="_Pagination" model="Model.Info" />
        </div>
    </div>
</div>