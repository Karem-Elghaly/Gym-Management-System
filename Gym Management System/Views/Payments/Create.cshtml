@model PaymentViewModel
@{
    ViewData["Title"] = "Add Payment";
}

<div class="card">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

        <form asp-action="Create" method="post">
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="SubscriptionId" class="form-label">Subscription</label>
                    <select asp-for="SubscriptionId" asp-items="(SelectList)ViewBag.Subscriptions" class="form-select">
                        <option value="">-- Select subscription --</option>
                    </select>
                    <div class="form-text">Only subscriptions with a remaining balance are listed.</div>
                    <span asp-validation-for="SubscriptionId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Amount" class="form-label">Amount (EGP)</label>
                    <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Method" class="form-label">Method</label>
                    <select asp-for="Method" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select>
                </div>

                <div class="col-md-4">
                    <label asp-for="Notes" class="form-label"></label>
                    <input asp-for="Notes" class="form-control" />
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>