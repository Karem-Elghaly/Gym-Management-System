@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@* كروت الإحصائيات *@
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-primary-subtle text-primary me-3"><i class="bi bi-people"></i></div>
                <div><div class="text-muted small">Total Members</div><div class="fs-4 fw-bold">@Model.TotalMembers</div></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-success-subtle text-success me-3"><i class="bi bi-card-checklist"></i></div>
                <div><div class="text-muted small">Active Subscriptions</div><div class="fs-4 fw-bold">@Model.ActiveSubscriptions</div></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-warning-subtle text-warning me-3"><i class="bi bi-hourglass-split"></i></div>
                <div><div class="text-muted small">Expiring in 7 days</div><div class="fs-4 fw-bold">@Model.ExpiringSoonCount</div></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-info-subtle text-info me-3"><i class="bi bi-calendar-check"></i></div>
                <div><div class="text-muted small">Today's Attendance</div><div class="fs-4 fw-bold">@Model.TodayAttendance</div></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-secondary-subtle text-secondary me-3"><i class="bi bi-calendar-event"></i></div>
                <div><div class="text-muted small">Upcoming Classes</div><div class="fs-4 fw-bold">@Model.UpcomingClassesCount</div></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="card stat-card">
            <div class="card-body d-flex align-items-center">
                <div class="stat-icon bg-danger-subtle text-danger me-3"><i class="bi bi-cash-coin"></i></div>
                <div><div class="text-muted small">This Month Revenue</div><div class="fs-4 fw-bold">@Model.MonthRevenue.ToString("N0") EGP</div></div>
            </div>
        </div>
    </div>
</div>

@* جدول الاشتراكات اللي قربت تنتهي *@
<div class="card">
    <div class="card-header bg-white fw-bold">Subscriptions expiring soon</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Member</th><th>Phone</th><th>Plan</th><th>Ends</th><th>Days left</th><th></th></tr>
            </thead>
            <tbody>
                @if (!Model.ExpiringSubscriptions.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No subscriptions expiring soon.</td></tr>
                }
                @foreach (var s in Model.ExpiringSubscriptions)
                {
                    <tr>
                        <td>@s.MemberName</td>
                        <td>@s.Phone</td>
                        <td>@s.PlanName</td>
                        <td>@s.EndDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge @(s.DaysLeft <= 2 ? "bg-danger" : "bg-warning text-dark")">@s.DaysLeft</span></td>
                        <td class="text-end">
                            <a asp-controller="Subscriptions" asp-action="Renew" asp-route-id="@s.SubscriptionId" class="btn btn-sm btn-outline-primary">Renew</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>