@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

@* شريط واحد بأرقام كبيرة بدل 6 كروت متطابقة. لون الخط الجانبي (--tone) بيدل على نوع الرقم *@
<div class="stat-strip mb-4">
    <div class="stat-cell" style="--tone: var(--ember)">
        <div class="stat-label">Members</div>
        <div class="stat-value">@Model.TotalMembers</div>
    </div>
    <div class="stat-cell" style="--tone: var(--bs-success)">
        <div class="stat-label">Active subscriptions</div>
        <div class="stat-value">@Model.ActiveSubscriptions</div>
    </div>
    <div class="stat-cell" style="--tone: var(--bs-warning)">
        <div class="stat-label">Ending within 7 days</div>
        <div class="stat-value">@Model.ExpiringSoonCount</div>
    </div>
    <div class="stat-cell" style="--tone: var(--bs-info)">
        <div class="stat-label">Checked in today</div>
        <div class="stat-value">@Model.TodayAttendance</div>
    </div>
    <div class="stat-cell" style="--tone: var(--bs-secondary)">
        <div class="stat-label">Upcoming classes</div>
        <div class="stat-value">@Model.UpcomingClassesCount</div>
    </div>
    <div class="stat-cell" style="--tone: var(--graphite)">
        <div class="stat-label">Revenue this month</div>
        <div class="stat-value">@Model.MonthRevenue.ToString("N0")<span class="stat-unit">EGP</span></div>
    </div>
</div>

<div class="card">
    <div class="card-header">Subscriptions ending soon</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Member</th><th>Phone</th><th>Plan</th><th>Ends</th><th>Days left</th><th></th></tr>
            </thead>
            <tbody>
                @if (!Model.ExpiringSubscriptions.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Nothing ends in the next 7 days.</td></tr>
                }
                @foreach (var s in Model.ExpiringSubscriptions)
                {
                    <tr>
                        <td class="fw-semibold">@s.MemberName</td>
                        <td>@s.Phone</td>
                        <td>@s.PlanName</td>
                        <td>@s.EndDate.ToString("yyyy-MM-dd")</td>
                        <td><span class="badge @(s.DaysLeft <= 2 ? "bg-danger" : "bg-warning text-dark")">@s.DaysLeft</span></td>
                        <td class="text-end">
                            <a asp-controller="Subscriptions" asp-action="Renew" asp-route-id="@s.SubscriptionId" class="btn btn-sm btn-outline-primary">Renew</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>